# ==========================================
# LiteratureAI Environment Configuration
# ==========================================

# LLM Provider Configuration
# Supported options: openai, groq, anthropic, gemini, local
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini
# Optional custom endpoint (e.g. http://localhost:11434/v1 for Ollama)
LLM_API_BASE=

# Academic Search API Credentials
# Semantic Scholar: Optional API key for higher rate limits (defaults to public access)
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex & Crossref: Email/Mailto for polite pool access (improves rate limits)
OPENALEX_EMAIL=researcher@literatureai.org
CROSSREF_MAILTO=researcher@literatureai.org

# arXiv Preprints API
ARXIV_ENABLED=true
